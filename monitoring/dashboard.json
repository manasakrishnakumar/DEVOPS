    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "targets": [
    {
     "expr": "kube_pod_status_ready{namespace=\"climate\",condition=\"true\"}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "CPU (cores) per pod",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "targets": [
    {
     "expr": "sum by (pod)(rate(container_cpu_usage_seconds_total{namespace=\"climate\",container!=\"\"}[1m]))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Memory (MiB) per pod",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "targets": [
    {
     "expr": "sum by (pod)(container_memory_working_set_bytes{namespace=\"climate\",container!=\"\"})/1024/1024",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Inference startup time (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
