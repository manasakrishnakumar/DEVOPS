   "type": "timeseries",
   "title": "Golden rejects at request time",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 48
   },
   "targets": [
    {
     "expr": "sum by (backend)(golden_reject_total) or vector(0)",
